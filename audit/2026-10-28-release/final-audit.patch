+const b=spawnSync('git',['-c','safe.directory='+root.replaceAll('\\','/'),'cat-file','--batch'],{cwd:root,input:names.map(n=>':'+n+'\n').join(''),maxBuffer:32e6});assert.equal(b.status,0);let offset=0;
