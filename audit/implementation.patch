+`;
+await writeFile(path.join(out,'sw.js'),worker);await writeFile(path.join(out,'release.json'),JSON.stringify({release,createdAt:new Date().toISOString(),files:inventory,bytes:[...files.values()].reduce((n,b)=>n+b.length,Buffer.byteLength(index))},null,2));await mkdir(path.join(root,'audit'),{recursive:true});await writeFile(path.join(root,'audit/build.json'),JSON.stringify({release,tracks:bundle.tracks.length,parts:bundle.parts.length,cups:bundle.cups.length,rivals:bundle.rivals.length,daily:bundle.daily.length,inventoryCount:inventory.length,verified:'Source parsed and compiled from content documents; no prior derived bundle used.'},null,2));console.log(`Built ${release}: 12 tracks / 81 builds / 4 cups / ${inventory.length} offline files`);

diff --git a/tools/content.mjs b/tools/content.mjs
new file mode 100644
--- /dev/null
+++ b/tools/content.mjs
@@ -0,0 +1,7 @@
+import {readFile,readdir} from 'node:fs/promises';
+import {DOMParser} from 'linkedom';
+import {parseTrack,parseEntities,hash,gameplay} from '../app/model.js';
+import {compile} from '../app/track.js';
+export async function loadContent(){const root=new URL('../content/',import.meta.url),read=p=>readFile(new URL(p,root),'utf8');const catalog=parseEntities(await read('catalog.html'),'CatalogEntry',DOMParser);const tracks=[];for(const c of catalog){const track=parseTrack(await read(c.path),DOMParser),compiled=compile(track);if(!compiled.valid)throw Error(track.name+': '+compiled.problems.map(p=>p.message).join('; '));if(c.id!==track.id)throw Error('Catalog identity mismatch');tracks.push({track,revision:await hash(gameplay(track))});}
+ const parts=[];for(const f of(await readdir(new URL('parts/',root))).sort())parts.push(...parseEntities(await read('parts/'+f),'Part',DOMParser));const cups=[];for(const f of(await readdir(new URL('cups/',root))).sort())cups.push(...parseEntities(await read('cups/'+f),'Cup',DOMParser));cups.sort((a,b)=>catalog.find(c=>a.tracks.includes(c.id)).cup-catalog.find(c=>b.tracks.includes(c.id)).cup);const rivals=parseEntities(await read('rivals.html'),'Rival',DOMParser),daily=parseEntities(await read('daily/daily-v1.html'),'Challenge',DOMParser);
+ if(catalog.length!==12||parts.length!==12||cups.length!==4||rivals.length!==8)throw Error('Incomplete content catalog.');for(const cup of cups)if(cup.tracks.split(' ').length!==3||cup.tracks.split(' ').some(id=>!tracks.some(t=>t.track.id===id)))throw Error('Invalid cup references');for(const b of[...rivals,...daily])for(const slot of['chassis','engine','tires','utility'])if(!parts.some(p=>p.id===b[slot]&&p.slot===slot))throw Error('Invalid build reference');for(const d of daily)if(!tracks.some(t=>t.track.id===d.track))throw Error('Invalid daily track');return{catalog,tracks,parts,cups,rivals,daily};}

