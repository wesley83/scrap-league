+const sourceIndex=await readFile(path.join(root,'app/index.html'),'utf8');const release='sl-'+digest([...files].map(([n,b])=>n+digest(b)).join('|')+sourceIndex).slice(0,14);const prefix='releases/'+release+'/';
+const manifest={id:'../../',name:'Scrap League',short_name:'Scrap League',start_url:'../../',scope:'../../',display:'standalone',background_color:'#253126',theme_color:'#202721',icons:[{src:'icon.svg',sizes:'any',type:'image/svg+xml',purpose:'any'}]};files.set('manifest.webmanifest',Buffer.from(JSON.stringify(manifest)));
+await mkdir(path.join(out,prefix,'vendor'),{recursive:true});for(const[n,b]of files)await writeFile(path.join(out,prefix,n),b);
+const index=sourceIndex.replace('<head>','<head><base href="./'+prefix+'">');await writeFile(path.join(out,'index.html'),index);const inventory=[{url:'./',hash:digest(index)},...[...files].map(([name,b])=>({url:'./'+prefix+name,hash:digest(b)}))];
+const worker=`const CACHE=${JSON.stringify(release)},INVENTORY=${JSON.stringify(inventory)};
+const hex=b=>Array.from(new Uint8Array(b),x=>x.toString(16).padStart(2,'0')).join('');
+self.addEventListener('install',event=>event.waitUntil((async()=>{const cache=await caches.open(CACHE);try{for(const entry of INVENTORY){const response=await fetch(new URL(entry.url,self.location),{cache:'reload'});if(!response.ok)throw Error('Missing release file');const bytes=await response.clone().arrayBuffer();if(hex(await crypto.subtle.digest('SHA-256',bytes))!==entry.hash)throw Error('Release integrity failure');await cache.put(new URL(entry.url,self.location),response);}}catch(e){await caches.delete(CACHE);throw e;}})()));
