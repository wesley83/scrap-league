+ for(let j=0;j<poly.length;j++){const a=poly[j],b=poly[(j+1)%poly.length],c=poly[(j+2)%poly.length],dx=b[0]-a[0],dz=b[1]-a[1],len=Math.hypot(dx,dz);let remaining=len-2*r;if(remaining<0)throw Error('Invalid polygon radius');while(remaining>0){const n=Math.min(60,remaining),p=appendPiece(t,j===0&&remaining===len-2*r?'start':'straight',{length:n,width:12,exitWidth:12},id);if(t.pieces.length===1){p.x=a[0]+dx/len*r;p.z=a[1]+dz/len*r;p.heading=Math.atan2(dz,dx);}remaining-=n;}const turn=Math.sign(dx*(c[1]-b[1])-dz*(c[0]-b[0]));appendPiece(t,'quarter',{radius:r,turn,width:12,exitWidth:12},id);}
