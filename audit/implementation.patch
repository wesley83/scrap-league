+import test from 'node:test';import assert from 'node:assert/strict';import {DOMParser} from 'linkedom';
+import {applyResult,freshProgress} from '../app/storage.js';
+import {loadContent} from '../tools/content.mjs';import {compile,pointAtPiece,pieceLength,atDistance} from '../app/track.js';import {parseTrack,serializeTrack,stable,clone} from '../app/model.js';import {assemble,allBuilds,STARTER} from '../app/builds.js';import {createCar,drive,aiInput,processGates,sweepCircle,crossing,DT,stepRace,resultOf,resetCar} from '../app/simulation.js';
+const content=await loadContent(),t=compile(content.tracks[0].track),spec=assemble(STARTER,content.parts);
+test('12 authoritative documents round trip with all owned fields',()=>{for(const {track}of content.tracks)assert.equal(stable(parseTrack(serializeTrack(track),DOMParser)),stable(track));});
+test('independent rounded rectangle length and arc endpoint',()=>{assert.ok(Math.abs(t.length-(2*(220+140)-8*40+2*Math.PI*40))<1e-8);const p={kind:'quarter',x:0,z:0,heading:0,radius:20,width:10,turn:1};const end=pointAtPiece(p,pieceLength(p));assert.ok(Math.abs(end.x-20)<1e-8&&Math.abs(end.z-20)<1e-8);assert.equal(end.heading,Math.PI/2);});
+test('all 81 unique legal builds, masses and tire tradeoffs',()=>{const builds=allBuilds(content.parts);assert.equal(builds.length,81);assert.equal(new Set(builds.map(stable)).size,81);assert.equal(spec.mass,960);assert.equal(assemble({chassis:'kite',engine:'longrunner',tires:'rally',utility:'capacitor'},content.parts).mass,940);for(const b of builds)assert.ok(assemble(b,content.parts).mass>0);});
+test('hostile/unknown imports are rejected before reconstruction',()=>{const html=serializeTrack(t.source);for(const changed of[html.replace('</body>','<script>alert(1)</script></body>'),html.replace('itemprop="name"','onclick="evil()" itemprop="name"'),html.replace('itemprop="laps"','itemprop="invented"'),html.replace('>pieces-v1<','>future<')])assert.throws(()=>parseTrack(changed,DOMParser));});
+test('geometry gaps, disconnected roads, overlaps and missing respawns fail',()=>{for(const mutate of[x=>x.pieces[3].x+=1,x=>x.pieces[3].nextPiece=x.pieces[2].id,x=>x.spawns.pop(),x=>x.gates[2].order=9]){const x=clone(t.source);mutate(x);assert.equal(compile(x).valid,false);}});
+test('finite gate accepts forward center crossing, rejects reverse and outside',()=>{const g={x:0,z:0,heading:0,width:10};assert.equal(crossing({x:-2,z:0},{x:2,z:0},g),.5);assert.equal(crossing({x:2,z:0},{x:-2,z:0},g),null);assert.equal(crossing({x:-2,z:6},{x:2,z:6},g),null);});
+test('swept circle catches high-speed wall and ignores parallel miss',()=>{const wall={a:{x:10,z:-5},b:{x:10,z:5}};const hit=sweepCircle({x:0,z:0},{x:100,z:0},1,wall);assert.ok(Math.abs(hit.time-.09)<1e-9);assert.equal(hit.nx,-1);assert.equal(sweepCircle({x:0,z:8},{x:100,z:0},1,wall),null);});
+test('out-of-order finish gives no lap or charge; reset preserves sequence',()=>{const c=createCar(spec,t.grid[0]);const f=t.gates[0];c.x=f.x+2;c.z=f.z;processGates(c,{x:f.x-2,z:f.z},t,1,DT,3);assert.equal(c.lap,0);assert.equal(c.charge,60);c.nextGate=3;c.lastGate=2;resetCar(c,t);assert.equal(c.nextGate,3);assert.equal(c.resetTime,2);assert.equal(c.charge,60);});
+test('legal gates award once and exact crossing time rounds splits once',()=>{const c=createCar(spec,t.grid[0]);let seconds=0;for(let lap=0;lap<3;lap++)for(const g of[...t.gates.slice(1),t.gates[0]]){const n={x:Math.cos(g.heading),z:Math.sin(g.heading)},a={x:g.x-n.x,z:g.z-n.z};c.x=g.x+n.x;c.z=g.z+n.z;seconds+=5.12345;processGates(c,a,t,seconds,.008,3);}assert.equal(c.lap,3);const result=resultOf({id:'test',mode:'trial',key:'k',track:t,build:STARTER,laps:3,difficulty:'club',cars:[c],time:seconds,dnf:false});assert.equal(result.splits.reduce((a,b)=>a+b,0),result.elapsedMs);assert.ok(Math.abs(c.finishTime-(seconds+.004))<1e-8);});
+test('pause does not advance simulation, boost or timers',()=>{const c=createCar(spec,t.grid[0]),r={state:'paused',time:10,cars:[c],track:t};stepRace(r,{throttle:1,boost:true});assert.equal(r.time,10);assert.equal(c.charge,60);});
+test('DNF history records elapsed time without rewriting completed lap splits',()=>{const c=createCar(spec,t.grid[0]);c.lapTimes=[31.234];const r={id:'abandoned',mode:'league',key:'k',track:t,build:STARTER,laps:3,difficulty:'club',cars:[c],time:45.678,dnf:true};const result=resultOf(r);assert.equal(result.elapsedMs,45678);assert.deepEqual(result.splits,[31234]);assert.equal(result.dnf,true);});
+test('Workshop completion never awards League progress or cup points',()=>{const p=freshProgress();p.cup={id:'cup',index:0,rounds:[]};const result=applyResult(p,{id:'workshop-test',mode:'workshop',dnf:false,difficulty:'club',classification:[{id:'player'}]},'cup',0);assert.deepEqual(result.completed,[]);assert.deepEqual(result.cup.rounds,[]);assert.deepEqual(result.medals,{});assert.deepEqual(result.history,['workshop-test']);});
+test('all circuits finish through legal AI controls without teleports', {timeout:300000},()=>{const evidence=[];for(const {track}of content.tracks){const ct=compile(track),c=createCar(spec,ct.grid[0]);let elapsed=0;for(;elapsed<240&&c.finishTime===null;elapsed+=DT){const prev={x:c.x,z:c.z};drive(c,aiInput(c,ct,'club'),ct);processGates(c,prev,ct,elapsed,DT,1);}evidence.push({track:track.slug,time:Math.round(elapsed),contacts:c.contacts,resets:c.resets,gate:c.nextGate});assert.notEqual(c.finishTime,null,JSON.stringify(evidence));}console.log('AI lap evidence',JSON.stringify(evidence));});

