+ const close=()=>document.querySelector('#modal').close();const trashButton=document.createElement('button');trashButton.textContent='Move current draft to Trash';trashButton.disabled=!this.store||!this.baseline;trashButton.onclick=()=>{close();this.dialog('Move draft to Trash?','You can restore it from Track files for seven days. The exported HTML remains available independently.',[{label:'Move to Trash',action:async()=>{await this.flush();await this.store.trashDraft(this.track.id,this.baseline);this.track=null;await this.open(duplicateTrack(this.templates[0]));}},{label:'Keep draft'}]);};body.querySelector('.file-actions').append(trashButton);if(trash.length){const heading=document.createElement('h3');heading.textContent='Trash · recoverable for seven days';body.append(heading);for(const d of trash){const b=document.createElement('button');b.textContent='Restore '+d.track.name;b.onclick=async()=>{close();const restored=await this.store.restoreDraft(d.track.id);await this.open(restored.track,restored);};body.append(b);}}body.querySelectorAll('[data-file]').forEach(b=>b.onclick=async()=>{close();switch(b.dataset.file){case'starter':await this.open(duplicateTrack(this.templates[0]));break;case'blank':{const t=duplicateTrack(this.templates[0]);t.name='Untitled circuit';for(const k of['pieces','props','patches','gates','spawns','recipes'])t[k]=[];await this.open(t);break;}case'duplicate':await this.open(duplicateTrack(this.track));break;case'export':this.export();break;case'import':this.q('import-track').click();break;case'recover':{const d=await this.store?.get('draft:'+this.track.id);if(d?.previous?.[0])this.command(t=>{Object.assign(t,clone(d.previous[0].track));});else this.notify('No previous committed snapshot yet.');break;}}});body.querySelectorAll('[data-draft]').forEach(b=>b.onclick=()=>{close();const d=drafts[+b.dataset.draft];this.open(d.track,d);});body.querySelectorAll('[data-template]').forEach(b=>b.onclick=()=>{close();this.open(duplicateTrack(this.templates[+b.dataset.template]));});await this.dialog('Track files',body,[{label:'Close'}]);}
+}

