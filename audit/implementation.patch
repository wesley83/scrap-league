+ restoreDraft(id){return this.update('draft:'+id,old=>{if(!old?.deletedAt||old.expiresAt<Date.now())throw Error('This draft is outside the seven-day recovery window.');const {deletedAt,expiresAt,...rest}=old;return {...rest,revision:old.revision+1};});}
