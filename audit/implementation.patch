+ constructor(db){this.db=db;db.onversionchange=()=>db.close();}
+ get(key){return new Promise((resolve,reject)=>{const tx=this.db.transaction('records'),r=tx.objectStore('records').get(key);r.onsuccess=()=>resolve(r.result);r.onerror=()=>reject(r.error);});}
