+import { showSubmission } from "../app/submission-ui.js";
+import { loadContent } from "../tools/content.mjs";
+import { RULES } from "../app/builds.js";
+const content = await loadContent(),
+  keys = await contentKeys(content);
+const result = () => ({
+  id: crypto.randomUUID(),
+  mode: "trial",
+  trackId: content.tracks[0].track.id,
+  trackName: "Yard Loop",
+  trackRevision: content.tracks[0].revision,
+  rulesRevision: RULES,
+  buildRevision: [...keys.builds][0],
+  assistance: "steering-off:manual",
+  laps: 3,
+  elapsedMs: 90000,
+  splits: [30000, 30000, 30000],
+});
+const config = {
+  policyRevision: "fixture",
+  paths: { trial: "/boards/trial.html", daily: "/boards/daily.html" },
+};
+test("a failed optional board cache does not turn a successful read into an unavailable board", async () => {
+  const board = new Boards(
+    {
+      set: async () => {
+        throw Error("quota");
+      },
+      get: async () => null,
+    },
+    {
+      config,
+      Parser: DOMParser,
+      fetcher: async () => new Response(""),
+    },
+  );
+  const { submission } = await import("../app/boards.js");
+  const value = await board.refresh(submission(result(), "Driver"));
+  assert.equal(value.stale, false);
+  assert.deepEqual(value.rows, []);
+  assert.equal(value.cacheError, "quota");
+});
+
+test("nickname normalization preserves Unicode and invalid/storage failures preserve the saved preference", async () => {
+  assert.equal(driverAlias("  Jose\u0301  "), "José");
+  assert.equal(driverAlias("🏎".repeat(24)), "🏎".repeat(24));
+  assert.throws(() => driverAlias("🏎".repeat(25)), /1–24/);
+  assert.throws(() => driverAlias("a\nb"), /control/);
+  assert.equal(
+    normalizeSettings({ driverAlias: "\u0000", sound: true }).driverAlias,
+    "Driver",
+  );
+  const settings = normalizeSettings({ driverAlias: "First" });
+  await assert.rejects(
+    rememberDriver(
+      settings,
+      { set: () => Promise.reject(Error("quota")) },
+      "Second",
+    ),
+    /quota/,
+  );
+  assert.equal(settings.driverAlias, "First");
+});
+
+test("unavailable board never blocks name entry, invalid input stays open, queue survives reopen", async () => {
+  const factory = new IDBFactory(),
+    store = await openStore({ factory }),
+    settings = normalizeSettings();
+  const document = new DOMParser().parseFromString(
+    "<!doctype html><html><body></body></html>",
+    "text/html",
+  );
+  let pumpCalls = 0;
+  const boards = {
+    refresh: async () => {
+      throw Error("offline");
+    },
+    pump: async () => {
+      pumpCalls++;
+    },
+  };
+  const r = result();
+  const open = () =>
+    showSubmission({
+      document,
+      result: r,
+      settings,
+      store,
+      boards,
+      identities: keys,
+      current: () => true,
+      dialog: (_title, body) => document.body.replaceChildren(body),
+    });
+  await open();
+  await new Promise((r) => setTimeout(r, 0));
+  const form = document.querySelector("form"),
+    input = form.querySelector("input");
+  assert.match(document.body.textContent, /Times unavailable/);
+  input.value = "  ";
+  await form.onsubmit({ preventDefault() {} });
+  assert.equal(input.value, "  ");
+  assert.equal(input.getAttribute("aria-invalid"), "true");
+  assert.equal((await store.keys("outbox:")).length, 0);
+  input.value = "Wesley 🏎";
+  await form.onsubmit({ preventDefault() {} });
+  assert.equal((await store.get("outbox:" + r.id)).run.alias, "Wesley 🏎");
+  assert.equal((await store.get("settings")).driverAlias, "Wesley 🏎");
+  assert.equal(pumpCalls, 1);
+  await open();
+  assert.equal(document.querySelector("input").readOnly, true);
+  assert.equal(document.querySelector("input").value, "Wesley 🏎");
+  assert.match(document.body.textContent, /Time queued/);
+  store.close();
+  const reopened = await openStore({ factory });
+  assert.equal((await reopened.get("outbox:" + r.id)).run.alias, "Wesley 🏎");
+  reopened.close();
+});
+
+test("queued identity cannot change payload; manual retry respects server delay and another tab's lease", async () => {
+  const store = await openStore({ factory: new IDBFactory() });
+  const run = { id: crypto.randomUUID(), alias: "Original" };
+  await store.enqueueRun(run);
+  await assert.rejects(
+    store.enqueueRun({ ...run, alias: "Changed" }),
+    /original driver name/,
+  );
+  const claim = await store.claimRun("one", 100);
+  await store.retryRuns(null, 200);
+  assert.equal(await store.claimRun("two", 201), null);
+  await store.settleRun(run.id, claim.lease.id, "retry", "offline", 300, 10000);
+  await store.retryRuns(run.id, 400);
+  assert.equal(await store.claimRun("two", 401), null);
+  const next = await store.claimRun("two", 10001);
+  assert.ok(next);
+  await store.settleRun(run.id, next.lease.id, "retry", "offline", 10002);
+  await store.retryRuns(run.id, 10003);
+  assert.ok(await store.claimRun("three", 10004));
+  store.close();
+});
+
+test("a request outliving its lease is attempted once per pump and stays recoverable", async () => {
+  const store = await openStore({ factory: new IDBFactory() });
+  const r = result(),
+    { submission } = await import("../app/boards.js"),
+    run = submission(r, "Driver");
+  await store.enqueueRun(run);
+  let clock = 100,
+    calls = 0;
+  const board = new Boards(store, {
+    config,
+    Parser: DOMParser,
+    clock: () => clock,
+    fetcher: async () => {
+      calls++;
+      clock += 31000;
+      throw Error("slow connection");
+    },
+  });
+  await board.pump();
+  assert.equal(calls, 1);
+  assert.equal((await store.get("outbox:" + run.id)).state, "sending");
+  assert.ok(await store.claimRun("other", clock));
+  store.close();
+});
+
+test("server Retry-After dates and seconds defer a queue read without a retry storm", async () => {
+  assert.equal(
+    retryAfterAt(new Response("", { headers: { "Retry-After": "60" } }), 1000),
+    61000,
+  );
+  const when = Date.parse("2026-10-17T21:00:00Z");
+  assert.equal(
+    retryAfterAt(
+      new Response("", {
+        headers: { "Retry-After": new Date(when).toUTCString() },
+      }),
+      when - 1000,
+    ),
+    when,
+  );
+  const store = await openStore({ factory: new IDBFactory() }),
+    { submission } = await import("../app/boards.js");
+  const run = submission(result(), "Driver");
+  await store.enqueueRun(run);
+  let calls = 0;
+  const board = new Boards(store, {
+    config,
+    Parser: DOMParser,
+    clock: () => 1000,
+    fetcher: async () => {
+      calls++;
+      return new Response("Slow down", {
+        status: 429,
+        headers: { "Retry-After": "60" },
+      });
+    },
+  });
+  await board.pump();
+  await store.retryRuns(run.id, 2000);
+  assert.equal(calls, 1);
+  assert.equal((await store.get("outbox:" + run.id)).nextAttemptAt, 61000);
+  store.close();
+});
diff --git a/tools/check-live-outbox.mjs b/tools/check-live-outbox.mjs
new file mode 100644
index 0000000..183494e
--- /dev/null
+++ b/tools/check-live-outbox.mjs
@@ -0,0 +1,155 @@
+// Two independent production store/queue clients; actual public endpoint;
+// only the acknowledgement after a real accepted POST is deliberately dropped.
+import fs from "node:fs/promises";
+import { randomUUID } from "node:crypto";
+import { DOMParser } from "linkedom";
+import { IDBFactory } from "fake-indexeddb";
+import { openStore } from "../app/storage.js";
+import { Boards } from "../app/boards.js";
+import { HOST_CONFIG } from "../app/pagelove.js";
+import { stable } from "../app/model.js";
+const file = new URL("../audit/handbook-live-outbox.json", import.meta.url);
+let key = "";
+async function run() {
+  const previous = JSON.parse(
+    await fs.readFile(
+      new URL("../audit/handbook-data-preservation.json", import.meta.url),
+      "utf8",
+    ),
+  );
+  const row = {
+    ...previous.synthetic,
+    id: randomUUID(),
+    alias: "Outbox check",
+  };
+  const report = {
+    utc: new Date().toISOString(),
+    id: row.id,
+    requests: [],
+    attempts: [],
+    method:
+      "Production Store and Boards with two independent IndexedDB connections in fake-indexeddb; actual public writes/readback; injected accepted-response loss. Not two physical browser tabs.",
+  };
+  await fs.writeFile(file, JSON.stringify(report, null, 2) + "\n");
+  const factory = new IDBFactory(),
+    a = await openStore({ factory }),
+    b = await openStore({ factory });
+  let acceptedResponsesDropped = 0;
+  const fetcher = async (url, options) => {
+    const response = await fetch(url, options);
+    report.requests.push({
+      method: options.method || "GET",
+      status: response.status,
+    });
+    if (options.method === "POST" && response.ok) {
+      acceptedResponsesDropped++;
+      await response.body?.cancel();
+      throw Error("Injected response loss after actual public acceptance");
+    }
+    return response;
+  };
+  const first = new Boards(a, { fetcher, Parser: DOMParser }),
+    second = new Boards(b, { fetcher, Parser: DOMParser });
+  try {
+    await a.enqueueRun(row);
+    for (let attempt = 0; attempt < 3; attempt++) {
+      await a.retryRuns(row.id);
+      await Promise.all([first.pump(), second.pump()]);
+      const entry = await b.get("outbox:" + row.id);
+      report.attempts.push({
+        state: entry.state,
+        identityPreserved: stable(entry.run) === stable(row),
+        claims: entry.attempts,
+      });
+      if (entry.state === "confirmed" || entry.state === "rejected") break;
+    }
+    const publicRows = (await first.readRows("trial")).rows.filter(
+      (value) => value.id === row.id,
+    );
+    report.checks = {
+      confirmed: (await a.get("outbox:" + row.id)).state === "confirmed",
+      onePublicCopy: publicRows.length === 1,
+      oneAcceptanceAcknowledgementDropped: acceptedResponsesDropped === 1,
+      everyAttemptKeptIdentity: report.attempts.every(
+        (value) => value.identityPreserved,
+      ),
+    };
+  } catch (error) {
+    report.error = error.message;
+  } finally {
+    a.close();
+    b.close();
+    const url = HOST_CONFIG.authoringOrigin + "/boards/trial.html";
+    const response = await fetch(url, {
+      headers: { Authorization: "Bearer " + key },
+      redirect: "error",
+      signal: AbortSignal.timeout(15000),
+    });
+    if (!response.ok || !response.headers.get("etag"))
+      throw Error("Cleanup baseline unavailable; owned ID retained in receipt");
+    const html = await response.text(),
+      marker = `itemprop="id" content="${row.id}"`,
+      index = html.indexOf(marker);
+    if (index >= 0) {
+      const start = html.lastIndexOf(
+          '<li itemscope itemtype="urn:ScrapLeague:Run">',
+          index,
+        ),
+        end = html.indexOf("</li>", index);
+      if (start < 0 || end < 0)
+        throw Error("Cannot isolate owned row for cleanup");
+      const cleaned = await fetch(url, {
+        method: "PUT",
+        redirect: "error",
+        signal: AbortSignal.timeout(15000),
+        headers: {
+          Authorization: "Bearer " + key,
+          "If-Match": response.headers.get("etag"),
+          "Content-Type": "text/html; charset=utf-8",
+        },
+        body: html.slice(0, start) + html.slice(end + 5),
+      });
+      if (!cleaned.ok)
+        throw Error("Conditional cleanup refused: " + cleaned.status);
+    }
+    const after = await fetch(url, {
+      headers: { Authorization: "Bearer " + key },
+      redirect: "error",
+      signal: AbortSignal.timeout(15000),
+    });
+    report.cleanup = {
+      conditional: true,
+      absent: after.ok && !(await after.text()).includes(marker),
+    };
+    report.passed =
+      !report.error &&
+      Object.values(report.checks || {}).every(Boolean) &&
+      !!report.checks &&
+      report.cleanup.absent;
+    await fs.writeFile(file, JSON.stringify(report, null, 2) + "\n");
+    key = "";
+  }
+  return report;
+}
+if (process.stdin.isTTY) process.stdin.setRawMode(true);
+process.stdin.setEncoding("utf8");
+let input = "";
+console.log("Ready for hidden JSON owner key.");
+process.stdin.on("data", async (chunk) => {
+  if (chunk.includes("\u0003")) process.exit(0);
+  input += chunk;
+  const end = input.search(/[\r\n]/);
+  if (end < 0) return;
+  process.stdin.pause();
+  try {
+    key = JSON.parse(input.slice(0, end)).key;
+    if (!key?.startsWith("pk_")) throw Error("Hidden key required");
+    console.log(JSON.stringify(await run()));
+  } catch (error) {
+    console.log(JSON.stringify({ error: error.message }));
+    process.exitCode = 1;
+  } finally {
+    key = "";
+    process.exit(process.exitCode || 0);
+  }
+});
diff --git a/tools/check-old-release.mjs b/tools/check-old-release.mjs
new file mode 100644
index 0000000..4d8591f
--- /dev/null
+++ b/tools/check-old-release.mjs
@@ -0,0 +1,60 @@
+// Read-only verification of the immutable dependencies used by pre-update clients.
+import fs from "node:fs/promises";
+import { createHash } from "node:crypto";
+const baselineURL = new URL(
+  "../audit/deployment-before-handbook-followup.json",
+  import.meta.url,
+);
+const baselineBytes = await fs.readFile(baselineURL);
+const baseline = JSON.parse(baselineBytes);
+if (
+  baseline.origin !== "https://hire-poker-8313.onpagelove.com" ||
+  !/^sl-[a-f0-9]{14}$/.test(baseline.release)
+)
+  throw Error("Unexpected deployment baseline");
+const prefix = "/releases/" + baseline.release + "/";
+const files = baseline.publicFiles.filter((row) => row.path.startsWith(prefix));
+if (!files.length || files.some((row) => row.path.includes("..")))
+  throw Error("Missing or invalid old dependency inventory");
+const checks = [];
+for (let start = 0; start < files.length; start += 4) {
+  await Promise.all(
+    files.slice(start, start + 4).map(async (file) => {
+      const response = await fetch(baseline.origin + file.path, {
+        redirect: "error",
+        cache: "no-store",
+        signal: AbortSignal.timeout(15000),
+      });
+      const bytes = Buffer.from(await response.arrayBuffer());
+      const hash = createHash("sha256").update(bytes).digest("hex");
+      checks.push({
+        path: file.path,
+        status: response.status,
+        expected: file.sha256,
+        actual: hash,
+        passed: response.status === 200 && hash === file.sha256,
+      });
+    }),
+  );
+}
+checks.sort((a, b) => a.path.localeCompare(b.path));
+const receipt = {
+  utc: new Date().toISOString(),
+  origin: baseline.origin,
+  release: baseline.release,
+  baselineSha256: createHash("sha256").update(baselineBytes).digest("hex"),
+  checks,
+  passed: checks.every((row) => row.passed),
+};
+await fs.writeFile(
+  new URL("../audit/handbook-old-client-assets.json", import.meta.url),
+  JSON.stringify(receipt, null, 2) + "\n",
+);
+console.log(
+  JSON.stringify({
+    release: receipt.release,
+    files: checks.length,
+    passed: receipt.passed,
+  }),
+);
+if (!receipt.passed) process.exitCode = 1;
diff --git a/tools/check-release-data.mjs b/tools/check-release-data.mjs
new file mode 100644
index 0000000..36497d5
--- /dev/null
+++ b/tools/check-release-data.mjs
@@ -0,0 +1,224 @@
+// A bounded, owned public row proves that publication preserves populated data.
+// Credentials stay in hidden terminal input and memory. No existing row is edited.
+import fs from "node:fs/promises";
+import path from "node:path";
+import { randomUUID, createHash } from "node:crypto";
+import { DOMParser } from "linkedom";
+import { Boards, runHTML } from "../app/boards.js";
+import { stable } from "../app/model.js";
+import { HOST_CONFIG } from "../app/pagelove.js";
+import {
+  BOARD_ORIGIN,
+  BOARD_PATHS,
+  loadOfficialBoardIdentities,
+} from "./board-policy.mjs";
+
+const root = path.resolve(import.meta.dirname, "..");
+const receiptPath = path.join(root, "audit/handbook-data-preservation.json");
+const boards = new Boards(null, { Parser: DOMParser });
+const hash = (value) => createHash("sha256").update(value).digest("hex");
+let key = "";
+async function owner(method = "GET", extra = {}) {
+  const response = await fetch(
+    new URL(BOARD_PATHS.trial, HOST_CONFIG.authoringOrigin),
+    {
+      method,
+      redirect: "error",
+      cache: "no-store",
+      signal: AbortSignal.timeout(15000),
+      ...extra,
+      headers: { Authorization: "Bearer " + key, ...extra.headers },
+    },
+  );
+  if (!response.ok) throw Error(`Owner ${method} returned ${response.status}`);
+  return response;
+}
+function records(html) {
+  const doc = new DOMParser().parseFromString(html, "text/html");
+  return [...doc.querySelectorAll("#runs > li")].map((row) => ({
+    id: row.querySelector("[itemprop=id]")?.getAttribute("content"),
+    hash: hash(row.outerHTML),
+  }));
+}
+async function save(receipt) {
+  await fs.writeFile(receiptPath, JSON.stringify(receipt, null, 2) + "\n");
+}
+async function seed() {
+  try {
+    await fs.access(receiptPath);
+    return resumeSeed();
+  } catch (error) {
+    if (error.code !== "ENOENT") throw error;
+  }
+  const identities = await loadOfficialBoardIdentities();
+  const trackId = Object.keys(identities.tracks)[0];
+  const run = {
+    id: randomUUID(),
+    alias: "Release check",
+    mode: "trial",
+    trackId,
+    trackRevision: identities.tracks[trackId],
+    rulesRevision: identities.rulesRevision,
+    buildRevision: identities.builds[0],
+    assist: "steering-off:manual",
+    laps: 3,
+    challenge: "",
+    elapsedMs: 480000,
+    splits: [160000, 160000, 160000],
+  };
+  const before = await owner();
+  const receipt = {
+    utc: new Date().toISOString(),
+    origin: BOARD_ORIGIN,
+    path: BOARD_PATHS.trial,
+    synthetic: run,
+    before: {
+      etag: before.headers.get("etag"),
+      rows: records(await before.text()),
+    },
+    state: "seed-attempted",
+    scope:
+      "Owned synthetic row and unchanged hashes of pre-existing rows; no private row payload recorded.",
+  };
+  // Persist the ID first so ambiguous acceptance can always be reconciled/cleaned.
+  await save(receipt);
+  return resumeSeed();
+}
+async function resumeSeed() {
+  const receipt = JSON.parse(await fs.readFile(receiptPath, "utf8"));
+  if (receipt.state === "awaiting-publication") return { state: receipt.state };
+  if (!["seed-attempted", "seed-not-confirmed"].includes(receipt.state))
+    throw Error("Receipt is already final");
+  const run = receipt.synthetic;
+  receipt.attempts ||= receipt.postStatus
+    ? [{ status: receipt.postStatus, note: "First response body not retained" }]
+    : [];
+  let stored = await boards.lookup(run);
+  if (!stored && receipt.attempts.length >= 3)
+    throw Error("Bounded seed attempts exhausted");
+  if (!stored) {
+    const posted = await fetch(new URL(BOARD_PATHS.trial, BOARD_ORIGIN), {
+      method: "POST",
+      redirect: "error",
+      credentials: "omit",
+      signal: AbortSignal.timeout(15000),
+      headers: { "Content-Type": "text/html", Range: "selector=#runs" },
+      body: runHTML(run),
+    });
+    receipt.attempts.push({
+      utc: new Date().toISOString(),
+      status: posted.status,
+      detail: posted.ok ? "" : (await posted.text()).slice(0, 1500),
+    });
+    if (posted.ok) await posted.body?.cancel();
+    stored = await boards.lookup(run);
+  }
+  if (!stored) {
+    receipt.state = "seed-not-confirmed";
+    await save(receipt);
+    throw Error("Synthetic seed not confirmed");
+  }
+  const { receivedAt, expiresAt, ...payload } = stored;
+  if (stable(payload) !== stable(run)) throw Error("Seed payload differs");
+  const populated = await owner();
+  receipt.populated = {
+    utc: new Date().toISOString(),
+    etag: populated.headers.get("etag"),
+    rows: records(await populated.text()),
+  };
+  receipt.state = "awaiting-publication";
+  await save(receipt);
+  return {
+    state: receipt.state,
+    rows: receipt.populated.rows.length,
+    syntheticId: run.id,
+  };
+}
+async function verifyAndClean() {
+  const receipt = JSON.parse(await fs.readFile(receiptPath, "utf8"));
+  const response = await owner(),
+    etag = response.headers.get("etag"),
+    html = await response.text();
+  if (!etag) throw Error("Missing conditional-write ETag");
+  const current = records(html),
+    expected = receipt.populated?.rows || [];
+  receipt.after = {
+    utc: new Date().toISOString(),
+    etag,
+    rows: current,
+    preserved:
+      expected.length > 0 &&
+      expected.every((row) =>
+        current.some((now) => now.id === row.id && now.hash === row.hash),
+      ),
+  };
+  // Cleanup only the owned ID and retain every other byte, conditional on the read.
+  const marker = `itemprop="id" content="${receipt.synthetic.id}"`;
+  const index = html.indexOf(marker);
+  if (index >= 0) {
+    const start = html.lastIndexOf(
+      '<li itemscope itemtype="urn:ScrapLeague:Run">',
+      index,
+    );
+    const end = html.indexOf("</li>", index);
+    if (start < 0 || end < 0) throw Error("Could not isolate owned row");
+    await owner("PUT", {
+      headers: { "If-Match": etag, "Content-Type": "text/html; charset=utf-8" },
+      body: html.slice(0, start) + html.slice(end + 5),
+    });
+  }
+  const cleaned = records(await (await owner()).text());
+  receipt.cleanup = {
+    utc: new Date().toISOString(),
+    ownedRowAbsent: !cleaned.some((row) => row.id === receipt.synthetic.id),
+    otherRowsPreserved: current
+      .filter((row) => row.id !== receipt.synthetic.id)
+      .every((row) =>
+        cleaned.some((now) => now.id === row.id && now.hash === row.hash),
+      ),
+  };
+  receipt.state =
+    receipt.after.preserved &&
+    receipt.cleanup.ownedRowAbsent &&
+    receipt.cleanup.otherRowsPreserved
+      ? "passed"
+      : "failed";
+  await save(receipt);
+  return {
+    state: receipt.state,
+    preservedRows: expected.length,
+    cleanup: receipt.cleanup,
+  };
+}
+if (process.stdin.isTTY) process.stdin.setRawMode(true);
+process.stdin.setEncoding("utf8");
+let input = "",
+  busy = false;
+console.log("Ready for hidden JSON: seed, verify-clean, quit.");
+process.stdin.on("data", async (chunk) => {
+  if (chunk.includes("\u0003")) process.exit(0);
+  input += chunk;
+  const end = input.search(/[\r\n]/);
+  if (end < 0) return;
+  const line = input.slice(0, end).trim();
+  input = input.slice(end + 1);
+  if (!line || busy) return;
+  busy = true;
+  try {
+    const command = JSON.parse(line);
+    if (command.op === "quit") process.exit(0);
+    key = command.key;
+    if (typeof key !== "string" || !key.startsWith("pk_"))
+      throw Error("Owner key required through hidden input");
+    if (!["seed", "verify-clean"].includes(command.op))
+      throw Error("Unsupported operation");
+    console.log(
+      JSON.stringify(await (command.op === "seed" ? seed() : verifyAndClean())),
+    );
+  } catch (error) {
+    console.log(JSON.stringify({ error: error.message }));
+  } finally {
+    key = "";
+    busy = false;
+  }
+});
diff --git a/tools/check-workshop-publication.mjs b/tools/check-workshop-publication.mjs
new file mode 100644
index 0000000..7ccd611
--- /dev/null
+++ b/tools/check-workshop-publication.mjs
@@ -0,0 +1,265 @@
+// Production publication functions against one disposable owner-authored circuit.
+import fs from "node:fs/promises";
+import { createHash } from "node:crypto";
+import { DOMParser } from "linkedom";
+import { loadContent } from "./content.mjs";
+import { duplicateTrack, gameplay, stable } from "../app/model.js";
+import { HOST_CONFIG, publishTrack } from "../app/pagelove.js";
+import {
+  publishOwnerTrack,
+  listTrack,
+  readPublishedTrack,
+  parseCatalog,
+} from "../app/publication.js";
+
+const file = new URL(
+  "../audit/handbook-workshop-publication.json",
+  import.meta.url,
+);
+const digest = (value) => createHash("sha256").update(value).digest("hex");
+let key = "";
+const save = (report) =>
+  fs.writeFile(file, JSON.stringify(report, null, 2) + "\n");
+async function request(path, options = {}) {
+  if (!path.startsWith("/workshop-tracks/") || path.includes(".."))
+    throw Error("Unsupported path");
+  return fetch(HOST_CONFIG.authoringOrigin + path, {
+    redirect: "error",
+    cache: "no-store",
+    signal: AbortSignal.timeout(15000),
+    ...options,
+    headers: { Authorization: "Bearer " + key, ...options.headers },
+  });
+}
+async function snapshot(id) {
+  const definition = await request(`/workshop-tracks/${id}/definition.html`);
+  if (!definition.ok)
+    throw Error("Definition snapshot failed: " + definition.status);
+  const catalog = await request("/workshop-tracks/catalog.html");
+  const entries = catalog.ok
+    ? parseCatalog(await catalog.text(), DOMParser)
+    : [];
+  return {
+    utc: new Date().toISOString(),
+    definitionHash: digest(await definition.text()),
+    catalogRows: entries.map((entry) => ({
+      id: entry.id,
+      hash: digest(stable(entry)),
+    })),
+  };
+}
+async function seed() {
+  try {
+    await fs.access(file);
+    throw Error("Existing fixture receipt must be reconciled first");
+  } catch (error) {
+    if (error.code !== "ENOENT") throw error;
+  }
+  const track = duplicateTrack((await loadContent()).tracks[0].track);
+  track.name = "Release preservation check";
+  track.slug = "release-check-" + track.id.slice(0, 8);
+  const report = {
+    utc: new Date().toISOString(),
+    id: track.id,
+    state: "started",
+    checks: {},
+    scope:
+      "Real pinned owner/public endpoints; injected stale catalog ETag and lost accepted response; only owned circuit is changed.",
+  };
+  await save(report);
+  let conflictInjected = false;
+  const first = await publishOwnerTrack(track, key, null, {
+    Parser: DOMParser,
+    fetcher: async (url, options) => {
+      if (
+        url.endsWith("/catalog.html") &&
+        options.method === "PUT" &&
+        !conflictInjected
+      ) {
+        conflictInjected = true;
+        options = {
+          ...options,
+          headers: {
+            ...options.headers,
+            "If-Match": '"deliberately-stale-fixture"',
+          },
+        };
+        delete options.headers["If-None-Match"];
+      }
+      return fetch(url, options);
+    },
+  });
+  report.checks.catalogConflictPreservesExactLink =
+    !first.listed &&
+    /Catalog changed/.test(first.listingError) &&
+    stable(
+      gameplay(await readPublishedTrack(track.id, { Parser: DOMParser })),
+    ) === stable(gameplay(track));
+  await save(report);
+  await listTrack(track, first.revision, key, { Parser: DOMParser });
+  report.checks.listingRetry = true;
+  const base = {
+    url:
+      HOST_CONFIG.authoringOrigin +
+      `/workshop-tracks/${track.id}/definition.html`,
+    pinnedOrigin: HOST_CONFIG.authoringOrigin,
+    key,
+    Parser: DOMParser,
+  };
+  let conflict = false;
+  try {
+    await publishTrack({
+      ...base,
+      track,
+      etag: '"deliberately-stale-fixture"',
+      baseline: track,
+    });
+  } catch (error) {
+    conflict = /Conflict/.test(error.message);
+  }
+  report.checks.staleTrackRefused = conflict;
+  const changed = { ...track, name: "Release preservation check B" };
+  const accepted = await publishTrack({
+    ...base,
+    track: changed,
+    baseline: first.baseline,
+    etag: first.etag,
+    fetcher: async (url, options) => {
+      const response = await fetch(url, options);
+      if (options.method === "PUT" && response.ok) {
+        await response.body?.cancel();
+        throw Error("Injected lost response after actual acceptance");
+      }
+      return response;
+    },
+  });
+  report.checks.ambiguousWrite = accepted.state;
+  report.checks.ambiguousSemanticReadback =
+    stable(
+      gameplay(await readPublishedTrack(track.id, { Parser: DOMParser })),
+    ) === stable(gameplay(changed));
+  const wrong = await request(`/workshop-tracks/${track.id}/definition.html`, {
+    headers: { Authorization: "Bearer deliberately-invalid-fixture" },
+  });
+  report.checks.wrongCredentialRefused = [401, 403].includes(wrong.status);
+  await wrong.body?.cancel();
+  await listTrack(changed, accepted.revision, key, { Parser: DOMParser });
+  report.before = await snapshot(track.id);
+  report.state = "awaiting-publication";
+  await save(report);
+  return { state: report.state, checks: report.checks, id: track.id };
+}
+async function verifyAndClean() {
+  const report = JSON.parse(await fs.readFile(file, "utf8"));
+  report.after = await snapshot(report.id);
+  report.preserved =
+    report.before.definitionHash === report.after.definitionHash &&
+    report.before.catalogRows.every((row) =>
+      report.after.catalogRows.some(
+        (now) => now.id === row.id && now.hash === row.hash,
+      ),
+    );
+  await save(report);
+  const definitionPath = `/workshop-tracks/${report.id}/definition.html`;
+  const createBaseline = await request(definitionPath);
+  const createConflict = await request(definitionPath, {
+    method: "PUT",
+    headers: {
+      "If-None-Match": "*",
+      "Content-Type": "text/html; charset=utf-8",
+    },
+    body: await createBaseline.text(),
+  });
+  report.checks.createOnlyConflictRefused = createConflict.status === 412;
+  await createConflict.body?.cancel();
+  await save(report);
+  const catalog = await request("/workshop-tracks/catalog.html"),
+    etag = catalog.headers.get("etag"),
+    html = await catalog.text();
+  const marker = `<span itemprop="id">${report.id}</span>`,
+    index = html.indexOf(marker);
+  if (!catalog.ok || !etag || index < 0)
+    throw Error("Cannot isolate owned catalog entry");
+  const start = html.lastIndexOf(
+      '<li itemscope itemtype="urn:ScrapLeague:PublishedTrack">',
+      index,
+    ),
+    end = html.indexOf("</li>", index);
+  if (start < 0 || end < 0) throw Error("Owned catalog row bounds unavailable");
+  const write = await request("/workshop-tracks/catalog.html", {
+    method: "PUT",
+    headers: { "If-Match": etag, "Content-Type": "text/html; charset=utf-8" },
+    body: html.slice(0, start) + html.slice(end + 5),
+  });
+  if (!write.ok)
+    throw Error("Conditional catalog cleanup failed: " + write.status);
+  const path = `/workshop-tracks/${report.id}/definition.html`,
+    definition = await request(path);
+  const removed = await request(path, {
+    method: "DELETE",
+    headers: { "If-Match": definition.headers.get("etag") },
+  });
+  const absent = await request(path);
+  const remaining = parseCatalog(
+    await (await request("/workshop-tracks/catalog.html")).text(),
+    DOMParser,
+  );
+  report.cleanup = {
+    definitionAbsent: absent.status === 404,
+    deletionStatus: removed.status,
+    ownedListingAbsent: !remaining.some((row) => row.id === report.id),
+    otherListingsPreserved: report.after.catalogRows
+      .filter((row) => row.id !== report.id)
+      .every((row) =>
+        remaining.some(
+          (now) => now.id === row.id && digest(stable(now)) === row.hash,
+        ),
+      ),
+  };
+  report.state =
+    report.preserved &&
+    report.checks.createOnlyConflictRefused &&
+    report.cleanup.definitionAbsent &&
+    report.cleanup.ownedListingAbsent &&
+    report.cleanup.otherListingsPreserved
+      ? "passed"
+      : "failed";
+  await save(report);
+  return {
+    state: report.state,
+    preserved: report.preserved,
+    cleanup: report.cleanup,
+  };
+}
+if (process.stdin.isTTY) process.stdin.setRawMode(true);
+process.stdin.setEncoding("utf8");
+let input = "",
+  busy = false;
+console.log("Ready for hidden JSON: seed, verify-clean, quit.");
+process.stdin.on("data", async (chunk) => {
+  if (chunk.includes("\u0003")) process.exit(0);
+  input += chunk;
+  const end = input.search(/[\r\n]/);
+  if (end < 0) return;
+  const line = input.slice(0, end).trim();
+  input = input.slice(end + 1);
+  if (!line || busy) return;
+  busy = true;
+  try {
+    const command = JSON.parse(line);
+    if (command.op === "quit") process.exit(0);
+    key = command.key;
+    if (typeof key !== "string" || !key.startsWith("pk_"))
+      throw Error("Hidden owner key required");
+    if (!["seed", "verify-clean"].includes(command.op))
+      throw Error("Unsupported operation");
+    console.log(
+      JSON.stringify(await (command.op === "seed" ? seed() : verifyAndClean())),
+    );
+  } catch (error) {
+    console.log(JSON.stringify({ error: error.message }));
+  } finally {
+    key = "";
+    busy = false;
+  }
+});
