+import { clone } from "./model.js";
+import { RULES, assemble, STARTER } from "./builds.js";
+export function recoverProgressContent(saved, content) {
+  const progress = clone(saved),
+    reasons = [];
+  const supported = (build) => {
+    try {
+      assemble(build, content.parts);
+      return true;
+    } catch {
+      return false;
+    }
+  };
+  if (!supported(progress.build)) {
+    progress.build = { ...STARTER };
+    reasons.push("Equipped parts are unavailable; restored the starter build.");
+  }
+  const presets = progress.presets.filter((p) => supported(p.build));
+  if (presets.length !== progress.presets.length) {
+    progress.presets = presets;
+    reasons.push("Unsupported presets were archived.");
+  }
+  const cup = progress.cup,
+    ids = new Set(content.rivals.map((r) => r.id));
+  if (
+    cup &&
+    (!Array.isArray(cup.rivals) ||
+      cup.rivals.length !== 5 ||
+      new Set(cup.rivals).size !== 5 ||
+      cup.rivals.some((id) => !ids.has(id)) ||
+      cup.rounds.some((r) =>
+        r.classification.some((c) => c.id !== "player" && !ids.has(c.id)),
+      ))
+  ) {
+    progress.cup = null;
+    reasons.push(
+      "Unsupported unfinished cup was archived; completed event rewards remain.",
+    );
+  }
+  return { progress, reasons };
+}
+
+export function captureAttempt(race, parts) {
+  return {
+    version: 1,
+    id: race.id,
+    index: race.index,
+    track: clone(race.track.source),
+    trackRevision: race.trackRevision,
+    build: clone(race.build),
+    parts: clone(parts),
+    settings: clone(race.settingsSnapshot),
+    seed: race.seed,
+    rules: RULES,
+    rivals: clone(race.rivals || []),
+    difficulty: race.difficulty,
+  };
+}
+
+export function resolveAttempt(cup, index, track, build) {
+  const pending = cup?.pending;
+  if (!pending || pending.index !== index)
+    return {
+      track: clone(track),
+      build: clone(build),
+      seed: (cup?.seed || 1) + index,
+    };
+  if (
+    pending.version !== 1 ||
+    !pending.track ||
+    !pending.parts ||
+    pending.rules !== RULES
+  ) {
+    throw Error(
+      "This unfinished attempt belongs to different racing rules. Your completed rounds are safe. Restart this round with the current rules to continue.",
+    );
+  }
+  return {
+    track: clone(pending.track),
+    build: clone(pending.build),
+    seed: pending.seed,
+    parts: clone(pending.parts),
+    settings: clone(pending.settings),
+    rivals: clone(pending.rivals),
+    resumed: true,
+  };
+}
+
+export function updateDegradation(race, wallSeconds, simulatedSeconds) {
+  const behind = wallSeconds - simulatedSeconds > 1 / 120;
+  race.overloadSeconds = behind ? (race.overloadSeconds || 0) + wallSeconds : 0;
+  if (race.overloadSeconds >= 2) race.performanceDegraded = true;
+  return !!race.performanceDegraded;
+}
diff --git a/dist/releases/sl-8c38d2602f174d/driver-profile.js b/dist/releases/sl-8c38d2602f174d/driver-profile.js
new file mode 100644
index 0000000..fc0bf1c
--- /dev/null
+++ b/dist/releases/sl-8c38d2602f174d/driver-profile.js
@@ -0,0 +1,56 @@
+// A remembered public nickname is a local preference, never an account identity.
+export function driverAlias(value) {
+  const name = typeof value === "string" ? value.normalize("NFC").trim() : "";
+  if (!name || [...name].length > 24 || /[\u0000-\u001f\u007f]/.test(name))
+    throw Error(
+      "Enter a driver name with 1–24 characters and no control characters.",
+    );
+  return name;
+}
+
+export function nameField(document, value = "Driver") {
+  const form = document.createElement("form");
+  form.className = "driver-profile";
+  form.noValidate = true;
+  const label = document.createElement("label"),
+    input = document.createElement("input"),
+    status = document.createElement("p");
+  label.textContent = "Public driver name";
+  input.name = "nickname";
+  input.autocomplete = "nickname";
+  input.dir = "auto";
+  input.value = value;
+  input.maxLength = 48; // Validation counts Unicode code points, not UTF-16 units.
+  input.required = true;
+  input.spellcheck = false;
+  status.id = "driver-name-status";
+  status.setAttribute("role", "status");
+  input.setAttribute("aria-describedby", status.id);
+  status.textContent =
+    "1–24 characters. Saved on this device; public only when you submit a time.";
+  label.append(input);
+  form.append(label, status);
+  const read = () => {
+    try {
+      const alias = driverAlias(input.value);
+      input.removeAttribute("aria-invalid");
+      return alias;
+    } catch (error) {
+      input.setAttribute("aria-invalid", "true");
+      status.textContent = error.message;
+      input.focus();
+      throw error;
+    }
+  };
+  form.onsubmit = (event) => event.preventDefault();
+  return { form, input, status, read };
+}
+
+export async function rememberDriver(settings, store, alias) {
+  const normalized = driverAlias(alias);
+  if (!store)
+    throw Error("Device storage is unavailable. Your name has not been saved.");
+  await store.set("settings", { ...settings, driverAlias: normalized });
+  settings.driverAlias = normalized;
+  return normalized;
+}
diff --git a/dist/releases/sl-8c38d2602f174d/driving-controls.js b/dist/releases/sl-8c38d2602f174d/driving-controls.js
new file mode 100644
index 0000000..51d1fcc
--- /dev/null
+++ b/dist/releases/sl-8c38d2602f174d/driving-controls.js
@@ -0,0 +1,164 @@
+import { clamp, wrap } from "./model.js";
+
+// Each contact owns an action; another release cannot cancel it.
+export class ContactActions {
+  constructor() {
+    this.contacts = new Map();
+  }
+  press(id, action) {
+    if (!this.contacts.has(id)) this.contacts.set(id, action);
+  }
+  release(id) {
+    this.contacts.delete(id);
+  }
+  has(action) {
+    return [...this.contacts.values()].includes(action);
+  }
+  clear() {
+    this.contacts.clear();
+  }
+}
+export function steeringAxis(clientX, rect) {
+  const axis = clamp(
+    (clientX - rect.left - rect.width / 2) / (rect.width * 0.4),
+    -1,
+    1,
+  );
+  return Math.abs(axis) <= 0.08
+    ? 0
+    : (Math.sign(axis) * (Math.abs(axis) - 0.08)) / 0.92;
+}
+export function bindTouchControls(root, { held, steer, active }) {
+  const contacts = new Map();
+  let padId = null,
+    rect;
+  const pad = root.querySelector("#steering-pad");
+  const axis = (value) => {
+    steer(value);
+    pad.style.setProperty("--steer", value);
+    pad.setAttribute("aria-valuenow", value.toFixed(2));
+  };
+  const release = (id) => {
+    const button = contacts.get(id);
+    if (!button) return;
+    contacts.delete(id);
+    held.release(id);
+    button.dataset.pressed = String([...contacts.values()].includes(button));
+    if (id === padId) {
+      padId = null;
+      axis(0);
+    }
+  };
+  for (const button of [...root.querySelectorAll("[data-hold]"), pad]) {
+    button.addEventListener("pointerdown", (e) => {
+      if (
+        !active() ||
+        (e.pointerType === "mouse" && e.button !== 0) ||
+        (button === pad && padId !== null)
+      )
+        return;
+      e.preventDefault();
+      contacts.set(e.pointerId, button);
+      button.setPointerCapture(e.pointerId);
+      button.dataset.pressed = "true";
+      if (button === pad) {
+        padId = e.pointerId;
+        rect = pad.getBoundingClientRect();
+        axis(steeringAxis(e.clientX, rect));
+      } else held.press(e.pointerId, button.dataset.hold);
+    });
+    button.addEventListener("pointermove", (e) => {
+      if (e.pointerType === "mouse" && e.buttons === 0) {
+        release(e.pointerId);
+        return;
+      }
+      if (e.pointerId === padId) axis(steeringAxis(e.clientX, rect));
+    });
+    for (const event of ["pointerup", "pointercancel", "lostpointercapture"])
+      button.addEventListener(event, (e) => release(e.pointerId));
+    button.addEventListener("keydown", (e) => {
+      if (!active()) return;
+      if (button === pad && ["ArrowLeft", "ArrowRight"].includes(e.key)) {
+        e.preventDefault();
+        axis(e.key === "ArrowLeft" ? -1 : 1);
+      } else if (button !== pad && [" ", "Enter"].includes(e.key)) {
+        e.preventDefault();
+        e.stopPropagation();
+        held.press("key:" + button.dataset.hold, button.dataset.hold);
+        button.dataset.pressed = "true";
+      }
+    });
+    button.addEventListener("keyup", (e) => {
+      if (button === pad) axis(0);
+      else if ([" ", "Enter"].includes(e.key)) {
+        held.release("key:" + button.dataset.hold);
+        button.dataset.pressed = "false";
+      }
+    });
+    button.addEventListener("blur", () => {
+      held.release("key:" + button.dataset.hold);
+      if (button === pad && padId === null) axis(0);
+      if (![...contacts.values()].includes(button))
+        button.dataset.pressed = "false";
+    });
+  }
+  const reset = () => {
+    const entries = [...contacts];
+    contacts.clear();
+    held.clear();
+    padId = null;
+    axis(0);
+    for (const [id, button] of entries) {
+      button.dataset.pressed = "false";
+      if (button.hasPointerCapture(id)) button.releasePointerCapture(id);
+    }
+    root
+      .querySelectorAll("[data-pressed]")
+      .forEach((b) => (b.dataset.pressed = "false"));
+  };
+  // A new coordinate mapping requires a new contact, including browser-chrome
+  // resizing that does not emit orientationchange.
+  new ResizeObserver(reset).observe(root);
+  window.addEventListener("resize", reset);
+  window.visualViewport?.addEventListener("resize", reset);
+  return reset;
+}
+export function practiceStep(practice, car, input) {
+  if (!practice) return;
+  const speed = Math.hypot(car.vx, car.vz);
+  if (speed > 5 && input.throttle > 0) practice.accelerate = true;
+  if (
+    speed > 3 &&
+    Math.abs(input.steer) > 0.2 &&
+    Math.abs(wrap(car.heading - practice.heading)) > 0.2
+  )
+    practice.steer = true;
+  if (speed > 3 && input.brake > 0) practice.brake = true;
+  if (car.boosting) practice.boost = true;
+}
+export function practicePrompt(practice, settings) {
+  const key = (action) =>
+    settings.bindings[action]
+      .replace("Key", "")
+      .replace("ShiftLeft", "Shift")
+      .replace("ShiftRight", "Shift");
+  if (!practice.accelerate)
+    return settings.autoAccelerate
+      ? "Auto throttle is on. Your car accelerates for you."
+      : settings.touch
+        ? "Hold GAS to accelerate."
+        : `Hold ${key("throttle")} to accelerate.`;
+  if (!practice.steer)
+    return settings.touch
+      ? "Steer into the bend with the wheel or arrow buttons."
+      : `Use ${key("left")} / ${key("right")} to follow the road into the bend.`;
+  if (!practice.brake)
+    return settings.touch
+      ? "Hold BRAKE before a bend. Release it to accelerate again."
+      : `Hold ${key("brake")} before a bend. Slow down before you turn.`;
+  if (!practice.boost)
+    return settings.touch
+      ? "On a straight, hold BOOST; it also accelerates. Checkpoints refill your charge."
+      : `On a straight, hold ${key("boost")} to boost. Checkpoints refill your charge.`;
+  return "All four skills tried. Follow every checkpoint and finish your lap.";
+}
diff --git a/dist/releases/sl-8c38d2602f174d/editor-commands.js b/dist/releases/sl-8c38d2602f174d/editor-commands.js
new file mode 100644
index 0000000..ed6d34b
--- /dev/null
+++ b/dist/releases/sl-8c38d2602f174d/editor-commands.js
@@ -0,0 +1,133 @@
+import { uid } from "./model.js";
+import { pieceLength, pointAtPiece } from "./track.js";
+export function transformSelection(
+  track,
+  ids,
+  { dx = 0, dz = 0, angle = 0 } = {},
+) {
+  if (![dx, dz, angle].every(Number.isFinite))
+    throw Error("Enter finite transform values.");
+  const selected = new Set(ids);
+  const gates = new Set(
+    track.gates.filter((g) => selected.has(g.pieceId)).map((g) => g.id),
+  );
+  const objects = [...track.pieces, ...track.props, ...track.spawns].filter(
+    (p) => selected.has(p.id) || gates.has(p.gateId),
+  );
+  if (!objects.length)
+    throw Error("Select a road, prop or spawn to transform.");
+  const center = objects.reduce(
+    (a, p) => ({
+      x: a.x + p.x / objects.length,
+      z: a.z + p.z / objects.length,
+    }),
+    { x: 0, z: 0 },
+  );
+  const c = Math.cos(angle),
+    s = Math.sin(angle);
+  for (const p of objects) {
+    const x = p.x - center.x,
+      z = p.z - center.z;
+    p.x = center.x + x * c - z * s + dx;
+    p.z = center.z + x * s + z * c + dz;
+    p.heading += angle;
+  }
+}
+export function addPatch(track, pieceId, values = {}) {
+  const piece = track.pieces.find((p) => p.id === pieceId);
+  if (!piece) throw Error("Select a road first.");
+  const patch = {
+    id: uid(),
+    pieceId,
+    surface: "gravel",
+    start: 0,
+    end: Math.min(20, pieceLength(piece)),
+    lateralMin: -piece.width / 2,
+    lateralMax: 0,
+    ...values,
+  };
+  if (
+    !["mud", "gravel"].includes(patch.surface) ||
+    ![patch.start, patch.end, patch.lateralMin, patch.lateralMax].every(
+      Number.isFinite,
+    ) ||
+    patch.start < 0 ||
+    patch.end <= patch.start ||
+    patch.end > pieceLength(piece) ||
+    patch.lateralMin >= patch.lateralMax ||
+    patch.lateralMin < -Math.min(piece.width, piece.exitWidth) / 2 ||
+    patch.lateralMax > Math.min(piece.width, piece.exitWidth) / 2
+  )
+    throw Error("Patch must fit within the selected road.");
+  track.patches.push(patch);
+  return patch;
+}
+export function createRecipe(
+  track,
+  { kind = "pad", duration = 1, damping = 0.2 } = {},
+) {
+  if (
+    !["pad", "barrier", "light-warm", "light-cool"].includes(kind) ||
+    !Number.isFinite(duration) ||
+    duration < 0.5 ||
+    duration > 1.5 ||
+    !Number.isFinite(damping) ||
+    damping < 0 ||
+    damping > 0.8
+  )
+    throw Error("Recipe is outside the supported bounds.");
+  if (track.recipes.length >= 16) throw Error("The limit is 16 recipes.");
+  const recipe = { id: uid(), kind, duration, damping };
+  track.recipes.push(recipe);
+  return recipe;
+}
+export function placeRecipe(track, pieceId, recipeId) {
+  const piece = track.pieces.find((p) => p.id === pieceId),
+    recipe = track.recipes.find((r) => r.id === recipeId);
+  if (!piece || !recipe) throw Error("Select a road and a recipe.");
+  const at = pointAtPiece(piece, pieceLength(piece) / 2);
+  const prop = {
+    id: uid(),
+    kind: "recipe:" + recipe.id,
+    x: at.x,
+    z: at.z,
+    heading: at.heading,
+    length: recipe.kind === "pad" ? 8 : 2,
+    width: recipe.kind === "pad" ? 6 : 1,
+    duration: recipe.duration,
+    damping: recipe.damping,
+  };
+  if (recipe.kind.startsWith("light")) {
+    prop.x -= Math.sin(at.heading) * (piece.width / 2 + 2);
+    prop.z += Math.cos(at.heading) * (piece.width / 2 + 2);
+  }
+  track.props.push(prop);
+  return prop;
+}
+export function deleteRecipe(track, id) {
+  if (track.props.some((p) => p.kind === "recipe:" + id))
+    throw Error("Remove or reassign the objects using this recipe first.");
+  track.recipes = track.recipes.filter((r) => r.id !== id);
+}
+export function editRecipe(track, id, values) {
+  const recipe = track.recipes.find((r) => r.id === id);
+  if (!recipe) throw Error("Choose an existing recipe.");
+  // Reuse the creation validator without consuming a slot or changing identity.
+  const checked = createRecipe({ recipes: [] }, { ...recipe, ...values });
+  Object.assign(recipe, {
+    kind: checked.kind,
+    duration: checked.duration,
+    damping: checked.damping,
+  });
+}
+export function assignRecipe(track, ids, recipeId) {
+  const recipe = track.recipes.find((r) => r.id === recipeId);
+  const selected = track.props.filter((p) => ids.includes(p.id));
+  if (!recipe || !selected.length)
+    throw Error("Select one or more objects and an existing recipe.");
+  for (const prop of selected) {
+    prop.kind = "recipe:" + recipe.id;
+    prop.duration = recipe.duration;
+    prop.damping = recipe.damping;
+  }
+}
