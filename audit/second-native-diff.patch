+import { clamp } from "./model.js";
+export class Sound {
+  constructor({ Context = globalThis.AudioContext } = {}) {
+    this.Context = Context;
+    this.enabled = false;
+    this.musicEnabled = true;
+    this.effectsVolume = 0.7;
+    this.musicVolume = 0.35;
+    this.voices = new Set();
+    this.started = false;
+    this.operation = 0;
