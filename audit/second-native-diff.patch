+    if (beat !== this.beat && this.musicEnabled) {
+      this.beat = beat;
+      const notes = {
+        yard: [55, 55, 82.4, 65.4],
+        docks: [65.4, 82.4, 73.4, 55],
+        foundry: [49, 58.3, 73.4, 58.3],
+        final: [65.4, 98, 82.4, 73.4],
