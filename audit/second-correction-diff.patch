+  for (const c of r.cars) {
+    const final = { x: c.x, z: c.z };
+    for (const segment of paths.get(c)) {
+      c.x = segment.to.x;
+      c.z = segment.to.z;
+      processGates(
+        c,
+        segment.from,
+        r.track,
+        r.time + segment.start,
+        segment.dt,
+        r.laps,
+      );
+    }
+    Object.assign(c, final);
+  }
+  r.collisionOverload = r.cars.some((c) => c.collisionLimited)
