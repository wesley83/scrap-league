+  yard: ["#b9b39a", "#a6a28b", "#364549", "#427a78"],
+  docks: ["#9bb9b7", "#86a8a6", "#33474f", "#c3704d"],
+  foundry: ["#c6a38b", "#b58e78", "#443e42", "#677c77"],
+  night: ["#30484b", "#385255", "#1d2d34", "#547e7c"],
+};
