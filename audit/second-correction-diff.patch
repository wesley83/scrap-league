diff --git a/dist/releases/sl-7480f2b6675883/submission-ui.js b/dist/releases/sl-7480f2b6675883/submission-ui.js
new file mode 100644
index 0000000..a690207
--- /dev/null
+++ b/dist/releases/sl-7480f2b6675883/submission-ui.js
@@ -0,0 +1,163 @@
+import { submission, recognized } from "./boards.js";
+import { nameField, rememberDriver } from "./driver-profile.js";
+import { time } from "./builds.js";
+
+export function submissionStatus(entry) {
+  if (!entry) return "Finish saved locally. Add your name to share this time.";
+  if (entry.state === "confirmed")
+    return "Time confirmed on the public leaderboard.";
+  if (entry.state === "rejected")
+    return (
+      entry.message ||
+      "The server rejected this time. Your local result is kept."
+    );
+  return (
+    "Time queued on this device under “" +
+    entry.run.alias +
+    "”. " +
+    (entry.serverRetryAt > Date.now()
+      ? "The server asked us to wait before retrying."
+      : "It will retry when a connection is available. You can close this window.")
+  );
+}
+
+// Board reads are optional. The durable submission path never depends on them.
+export async function showSubmission({
+  document,
+  result,
+  settings,
+  store,
+  boards,
+  identities,
+  dialog,
+  current,
+}) {
+  const initial = submission(result, settings.driverAlias);
+  recognized(initial, await identities);
+  if (!current()) return;
+  const body = document.createElement("div"),
+    field = nameField(document, settings.driverAlias),
+    intro = document.createElement("p"),
+    status = document.createElement("p"),
+    boardStatus = document.createElement("p"),
+    list = document.createElement("ol"),
+    submit = document.createElement("button");
+  intro.textContent =
+    time(result.elapsedMs) +
+    " · " +
+    result.trackName +
+    ". Your name and time become public when submitted. Casual client-reported times expire five days after receipt.";
+  status.setAttribute("role", "status");
+  status.dataset.submissionStatus = "";
+  list.className = "board-list";
+  submit.type = "submit";
+  submit.className = "primary";
+  submit.textContent = "Submit this time";
+  submit.disabled = true;
+  field.form.append(submit);
+  body.append(intro, field.form, status, boardStatus, list);
+  let entry = null,
+    busy = false,
+    refreshToken = 0;
+  const update = () => {
+    status.textContent = submissionStatus(entry);
+    field.input.readOnly = !!entry;
+    if (entry) field.input.value = entry.run.alias;
+    submit.disabled = !!entry || busy || !store;
+    submit.textContent = entry
+      ? entry.state === "confirmed"
+        ? "Submitted"
+        : entry.state === "rejected"
+          ? "Not accepted"
+          : "Already queued"
+      : "Submit this time";
+  };
+  const refresh = async () => {
+    const token = ++refreshToken;
+    boardStatus.textContent = list.children.length
+      ? "Refreshing saved display…"
+      : "Loading matching times…";
+    try {
+      const board = await boards.refresh(initial);
+      if (!body.isConnected || token !== refreshToken) return;
+      list.replaceChildren();
+      for (const row of board.rows) {
+        const li = document.createElement("li"),
+          name = document.createElement("bdi"),
+          value = document.createElement("strong");
+        name.textContent = row.alias;
+        value.textContent = time(row.elapsedMs);
+        li.append(name, value);
+        list.append(li);
+      }
+      boardStatus.textContent = board.stale
+        ? "Saved times · refresh failed. " + board.error
+        : board.rows.length
+          ? "Latest matching times"
+          : "No matching times yet. Set the first one.";
+    } catch (error) {
+      if (body.isConnected && token === refreshToken)
+        boardStatus.textContent =
+          "Times unavailable. You can still queue your result. " +
+          error.message;
+    }
+  };
+  const reconcile = async () => {
+    if (busy) return;
+    busy = true;
+    try {
+      await store?.retryRuns(result.id);
+      await boards.pump();
+      const saved = await store?.get("outbox:" + result.id);
+      if (body.isConnected) {
+        entry = saved || entry;
+        update();
+        await refresh();
+      }
+    } catch (error) {
+      if (body.isConnected)
+        status.textContent = error.message + " Your queued time is retained.";
+    } finally {
+      busy = false;
+      if (body.isConnected) update();
+    }
+  };
+  field.form.onsubmit = async (event) => {
+    event.preventDefault();
+    if (busy || entry) return;
+    busy = true;
+    submit.disabled = true;
+    try {
+      const alias = field.read(),
+        run = submission(result, alias);
+      await rememberDriver(settings, store, alias);
+      entry = await store.enqueueRun(run);
+      if (body.isConnected) update();
+    } catch (error) {
+      if (body.isConnected)
+        status.textContent =
+          error.message + " Your entry is kept; correct it or retry.";
+    } finally {
+      busy = false;
+      submit.disabled = !!entry || !store;
+    }
+    if (entry) void reconcile();
+  };
+  dialog("ADD YOUR TIME", body, [
+    { label: "Refresh / retry", keep: true, action: reconcile },
+    { label: "Close" },
+  ]);
+  field.input.focus();
+  try {
+    entry = await store?.get("outbox:" + result.id);
+    if (!body.isConnected) return;
+    update();
+    if (!store)
+      status.textContent =
+        "Device storage is unavailable. Download your result to keep it.";
+  } catch (error) {
+    status.textContent = "Could not read saved submissions: " + error.message;
+    return;
+  }
+  void refresh();
+}
diff --git a/dist/releases/sl-7480f2b6675883/track-document.js b/dist/releases/sl-7480f2b6675883/track-document.js
new file mode 100644
index 0000000..e30be3a
--- /dev/null
+++ b/dist/releases/sl-7480f2b6675883/track-document.js
@@ -0,0 +1,47 @@
+import { parseTrack, serializeTrack, structuralErrors } from "./model.js";
+
+const freeze = (value) => {
+  if (value && typeof value === "object") {
+    Object.values(value).forEach(freeze);
+    Object.freeze(value);
+  }
+  return value;
+};
+
+// This semantic subtree is the Workshop's editable source. Numeric projections
+// are frozen and rebuilt after a source change; command candidates are temporary.
+export class TrackDocument {
+  constructor(root, Parser = DOMParser) {
+    this.root = root;
+    this.Parser = Parser;
+    this.revision = 0;
+  }
+  replace(value) {
+    if (!value) {
+      this.root.replaceChildren();
+      this.projection = null;
+      this.revision++;
+      return;
+    }
+    const errors = structuralErrors(value);
+    if (errors.length) throw Error(errors.join(" "));
+    const html = serializeTrack(value),
+      candidate = parseTrack(html, this.Parser);
+    const doc = new this.Parser().parseFromString(html, "text/html");
+    // Commit the whole aggregate once validation succeeds. Partial roads are
+    // legal drafts; geometric race readiness remains the compiler's decision.
+    this.root.replaceChildren(
+      doc.querySelector('[itemtype="urn:ScrapLeague:Track"]'),
+    );
+    this.projection = freeze(candidate);
+    this.revision++;
+  }
+  read() {
+    return this.projection || null;
+  }
+  html() {
+    return this.projection
+      ? serializeTrack(parseTrack(this.root.innerHTML, this.Parser))
+      : "";
+  }
+}
diff --git a/dist/releases/sl-7480f2b6675883/track.js b/dist/releases/sl-7480f2b6675883/track.js
new file mode 100644
index 0000000..a8be148
--- /dev/null
+++ b/dist/releases/sl-7480f2b6675883/track.js
@@ -0,0 +1,511 @@
+import { clamp, wrap, structuralErrors, uid } from "./model.js";
+export const TAU = Math.PI * 2;
+export function pieceLength(p) {
+  return ["quarter", "hairpin"].includes(p.kind)
+    ? p.radius * Math.PI * (p.kind === "hairpin" ? 1 : 0.5)
+    : p.length;
+}
+export function pointAtPiece(p, s) {
+  const length = pieceLength(p),
+    u = clamp(s, 0, length),
+    c = Math.cos(p.heading),
+    n = Math.sin(p.heading);
+  if (["quarter", "hairpin"].includes(p.kind)) {
+    const a = u / p.radius;
+    return {
+      x:
+        p.x +
+        c * p.radius * Math.sin(a) -
+        n * p.turn * p.radius * (1 - Math.cos(a)),
+      z:
+        p.z +
+        n * p.radius * Math.sin(a) +
+        c * p.turn * p.radius * (1 - Math.cos(a)),
+      heading: p.heading + p.turn * a,
+      width: p.width,
+    };
+  }
+  return {
+    x: p.x + c * u,
+    z: p.z + n * u,
+    heading: p.heading,
+    width: p.width + ((p.exitWidth - p.width) * u) / length,
+  };
+}
+export function compile(t) {
+  const problems = structuralErrors(t).map((message) => ({
+    message,
+    severity: "error",
+  }));
+  const err = (message, id) =>
+      problems.push({ message, id, severity: "error" }),
+    map = new Map(t.pieces.map((p) => [p.id, p]));
+  const route = [],
+    visited = new Set();
+  let cur = t.pieces.find((p) => p.kind === "start") || t.pieces[0];
+  while (cur && !visited.has(cur.id)) {
+    visited.add(cur.id);
+    route.push(cur);
+    cur = map.get(cur.nextPiece);
+  }
+  if (!cur || route.length !== t.pieces.length || cur !== route[0])
+    err("Road must form one closed loop containing every piece.");
+  if (t.pieces.filter((p) => p.kind === "start").length !== 1)
+    err("Use exactly one start straight.");
+  let length = 0;
+  const samples = [],
+    offsets = new Map(),
+    walls = [];
+  for (const p of route) {
+    if (
+      !["start", "straight", "quarter", "hairpin", "taper"].includes(p.kind)
+    ) {
+      err("Unknown road piece.", p.id);
+      continue;
+    }
+    if (![8, 10, 12].includes(p.width) || ![8, 10, 12].includes(p.exitWidth))
+      err("Road widths must be 8, 10 or 12 m.", p.id);
+    if (p.kind === "start" && (p.length !== 60 || p.width < 10))
+      err("Start must be 60 m long and at least 10 m wide.", p.id);
+    if (p.kind === "straight" && ![20, 40, 60].includes(p.length))
+      err("Straight length must be 20, 40 or 60 m.", p.id);
+    if (p.kind === "taper" && p.length !== 40)
+      err("Tapers are 40 m long.", p.id);
+    if (
+      ["quarter", "hairpin"].includes(p.kind) &&
+      (![20, 40].includes(p.radius) || ![-1, 1].includes(p.turn))
+    )
+      err("Bend requires radius 20/40 m and left/right turn.", p.id);
+    if (p.kind !== "taper" && p.exitWidth !== p.width)
+      err("Use a taper to change width.", p.id);
+    if (
+      ![p.x, p.z, p.heading, p.length, p.radius].every(Number.isFinite) ||
+      Math.max(Math.abs(p.x), Math.abs(p.z)) > 1000
+    ) {
+      err("Road transform is outside bounds.", p.id);
+      continue;
+    }
+    const len = pieceLength(p);
+    if (!(len > 0 && len <= 200)) {
+      err("Invalid piece length.", p.id);
+      continue;
+    }
+    offsets.set(p.id, length);
+    const count = Math.ceil(len / 2);
+    for (let i = 0; i < count; i++) {
+      const at = pointAtPiece(p, (len * i) / count);
+      samples.push({
+        ...at,
+        s: length + (len * i) / count,
+        pieceId: p.id,
+        local: (len * i) / count,
+      });
+    }
+    length += len;
+    const end = pointAtPiece(p, len),
+      next = map.get(p.nextPiece);
+    if (
+      next &&
+      (Math.hypot(end.x - next.x, end.z - next.z) > 0.02 ||
+        Math.abs(wrap(end.heading - next.heading)) > Math.PI / 1800 ||
+        Math.abs(end.width - next.width) > 0.01)
+    )
+      err("Connector gap, direction or width mismatch.", p.id);
+  }
+  if (length < 200 || length > 4000) err("Route length must be 200–4,000 m.");
+  if (samples.length > 4096) err("Route exceeds 4,096 samples.");
+  const segs = samples.map((a, i) => {
+    const b = samples[(i + 1) % samples.length],
+      len = (b.s || length) - a.s;
+    return { a, b, len, index: i };
+  });
+  for (const seg of segs) {
+    for (const sign of [-1, 1]) {
+      const side = (q) => ({
+        x: q.x - Math.sin(q.heading) * q.width * 0.5 * sign,
+        z: q.z + Math.cos(q.heading) * q.width * 0.5 * sign,
+      });
+      walls.push({ a: side(seg.a), b: side(seg.b) });
+    }
+  }
+  // Nonadjacent corridors must not cross; route-distance exclusion allows neighboring arc chords.
+  for (let i = 0; i < samples.length; i += 3) {
+    const a = samples[i];
+    for (let j = i + 3; j < samples.length; j += 3) {
+      const b = samples[j],
+        ds = Math.min(Math.abs(a.s - b.s), length - Math.abs(a.s - b.s));
+      if (
+        ds > Math.max(a.width, b.width) * 2 + 4 &&
+        Math.hypot(a.x - b.x, a.z - b.z) < (a.width + b.width) / 2 + 0.5
+      ) {
+        err(
+          "Nonadjacent roads overlap or have insufficient clearance.",
+          b.pieceId,
+        );
+        i = samples.length;
+        break;
+      }
+    }
+  }
+  const track = {
+    source: t,
+    props: t.props.map((p) => {
+      const r = t.recipes.find((r) => p.kind === "recipe:" + r.id);
+      return r
+        ? {
+            ...p,
+            kind: r.kind.startsWith("light-") ? "light" : r.kind,
+            duration: r.duration,
+            damping: r.damping,
+            lightPreset: r.kind,
+          }
+        : p;
+    }),
+    length,
+    samples,
+    segs,
+    walls,
+    offsets,
+    problems,
+    route,
+  };
+  const gates = t.gates
+    .map((g) => {
+      const p = map.get(g.pieceId);
+      if (!p || g.distance < 0 || g.distance > pieceLength(p)) {
+        err("Gate must lie on its referenced piece.", g.id);
+        return null;
+      }
+      return {
+        ...g,
+        ...pointAtPiece(p, g.distance),
+        s: (offsets.get(p.id) || 0) + g.distance,
+      };
+    })
+    .filter(Boolean)
+    .sort((a, b) => a.order - b.order);
+  if (
+    gates.filter((g) => g.kind === "finish").length !== 1 ||
+    gates[0]?.kind !== "finish"
+  )
+    err("Gate zero must be the single finish.");
+  if (gates.length < 4 || gates.length > 33)
+    err("Use 3–32 checkpoints plus finish.");
+  gates.forEach((g, i) => {
+    if (g.order !== i || !["finish", "checkpoint"].includes(g.kind))
+      err("Gate orders must be contiguous from zero.", g.id);
+    if (i > 0 && g.s <= gates[i - 1].s)
+      err("Checkpoints must follow route order.", g.id);
+    const next = gates[(i + 1) % gates.length],
+      gap = (next.s - g.s + length) % length;
+    if (gap < 20 || gap > 200) err("Gate spacing must be 20–200 m.", g.id);
+  });
+  track.gates = gates;
+  const grid = t.spawns
+    .filter((s) => s.role === "grid")
+    .sort((a, b) => a.slot - b.slot);
+  if (grid.length !== 6 || grid.some((s, i) => s.slot !== i + 1))
+    err("Provide six ordered grid positions.");
+  for (const s of t.spawns) {
+    if (!["grid", "respawn"].includes(s.role)) err("Unknown spawn role.", s.id);
+    const q = nearest(track, s.x, s.z);
+    if (!q || q.distance > q.width / 2 - 2.6)
+      err("Spawn does not clear the road edge.", s.id);
+    if (Math.abs(wrap(s.heading - (q?.heading || 0))) > 0.1)
+      err("Spawn must face forward.", s.id);
+    if (s.role === "respawn" && !gates.some((g) => g.id === s.gateId))
+      err("Respawn references a missing gate.", s.id);
+  }
+  for (let i = 0; i < grid.length; i++)
+    for (let j = i + 1; j < grid.length; j++)
+      if (Math.hypot(grid[i].x - grid[j].x, grid[i].z - grid[j].z) < 4.6)
+        err("Grid cars overlap.", grid[j].id);
+  for (const g of gates)
+    if (
+      t.spawns.filter((s) => s.role === "respawn" && s.gateId === g.id)
+        .length !== 1
+    )
+      err("Each gate needs one safe respawn.", g.id);
+  for (const p of t.patches) {
+    const road = map.get(p.pieceId);
+    if (
+      !road ||
+      !["gravel", "mud"].includes(p.surface) ||
+      p.start < 0 ||
+      p.end <= p.start ||
+      p.end > pieceLength(road) ||
+      p.lateralMin >= p.lateralMax ||
+      p.lateralMin < -road.width / 2 ||
+      p.lateralMax > road.width / 2
+    )
+      err("Surface patch is outside its road.", p.id);
+    for (const b of t.patches)
+      if (
+        p.id < b.id &&
+        p.pieceId === b.pieceId &&
+        p.surface !== b.surface &&
+        p.start < b.end &&
+        b.start < p.end &&
+        p.lateralMin < b.lateralMax &&
+        b.lateralMin < p.lateralMax
+      )
+        err("Different surfaces overlap.", p.id);
+  }
+  for (const p of track.props) {
+    if (
+      !["barrier", "island", "pad", "light"].includes(p.kind) ||
+      p.length < 1 ||
+      p.length > 12 ||
+      p.width < 0.5 ||
+      p.width > 6 ||
+      p.duration < 0.5 ||
+      p.duration > 1.5 ||
+      p.damping < 0 ||
+      p.damping > 0.8
+    )
+      err("Unsupported prop or parameter bounds.", p.id);
+    const q = nearest(track, p.x, p.z);
+    if (!q) continue;
+    const footprint =
+      Math.abs(Math.sin(p.heading - q.heading)) * p.length +
+      Math.abs(Math.cos(p.heading - q.heading)) * p.width;
+    if (p.kind === "pad") {
+      if (q.distance + footprint / 2 > q.width / 2)
+        err("Boost pad must fit inside the road.", p.id);
+    } else if (p.kind !== "light") {
+      if (q.distance < q.width / 2 && q.width - footprint < 4)
+        err("Obstacle must leave at least 4 m of passage.", p.id);
+      for (const g of gates)
