+  for (const c of r.cars)
+    drive(
+      c,
+      c.id === "player"
+        ? input
+        : profiledInput(c, r, () =>
+            aiInput(c, r.track, r.difficulty, c.personality, r.cars),
+          ),
+      r.track,
+      dt,
+      true,
+    );
