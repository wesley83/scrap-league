+    } catch (error) {
+      const cached = await this.store?.get("board:" + key);
+      if (!cached) throw error;
+      return {
+        rows: ranked(
+          cached.rows,
+          key,
+          this.clock() + (cached.serverOffset || 0),
+        ),
+        stale: true,
+        refreshedAt: cached.refreshedAt,
+        error: error.message,
+      };
