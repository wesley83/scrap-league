+  t.spawns = spawns;
+}
+export function appendPiece(t, kind, options = {}, newId = uid) {
+  const prev = t.pieces.at(-1),
+    end = prev
+      ? pointAtPiece(prev, pieceLength(prev))
+      : { x: 0, z: 0, heading: 0, width: 12 };
+  const p = {
+    id: newId(),
+    kind,
+    x: end.x,
+    z: end.z,
+    heading: end.heading,
+    width: end.width,
+    exitWidth: end.width,
+    length: kind === "start" ? 60 : 40,
+    radius: 40,
+    turn: 1,
+    nextPiece: "",
+    ...options,
+  };
