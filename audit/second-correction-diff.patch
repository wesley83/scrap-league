+    seed: r.seed,
+    laps: r.laps,
+    difficulty: r.difficulty,
+    elapsedMs: total,
+    splits,
+    dnf: r.dnf,
+    classification: classification(r).map((c) => ({
+      id: c.id,
+      name: c.name || "You",
+      time: c.finishTime === null ? null : Math.round(c.finishTime * 1000),
+    })),
+    contacts: p.contacts,
+    resets: p.resets,
+    createdAt: new Date().toISOString(),
+  };
+}
