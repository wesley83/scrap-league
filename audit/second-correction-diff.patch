+  t.pieces.push(p);
+  return p;
+}
+export function closeLoop(t) {
+  if (t.pieces.length) t.pieces.at(-1).nextPiece = t.pieces[0].id;
+}
+export function reflow(t) {
+  for (let i = 1; i < t.pieces.length; i++) {
+    const p = t.pieces[i],
+      prev = t.pieces[i - 1],
+      end = pointAtPiece(prev, pieceLength(prev));
+    p.x = end.x;
+    p.z = end.z;
+    p.heading = end.heading;
+    prev.nextPiece = p.id;
+  }
+  closeLoop(t);
+}
