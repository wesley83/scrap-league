+export function surfaceSize(w, h, dpr = 1, low = false) {
+  const scale = Math.min(
+    low ? 1 : 2,
+    Number.isFinite(dpr) ? Math.max(1, dpr) : 1,
+    Math.sqrt(2400000 / Math.max(1, w * h)),
+    4096 / Math.max(1, w, h),
+  );
