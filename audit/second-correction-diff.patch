+      b = atDistance(track, q.s + ahead + 4),
+      curve = Math.abs(wrap(b.heading - a.heading)) / 4,
+      grip = car.spec.tires[surfaceAt(track, a.x, a.z)];
+    if (curve > 0.001) {
+      const turnSpeed = Math.sqrt((grip * 9.81 * 0.72) / curve) * pace;
