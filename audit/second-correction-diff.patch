+    try {
+      const { rows, serverTime } = await this.readRows(run.mode),
+        now = serverTime ?? this.clock();
+      const cached = {
+        version: 1,
+        rows,
+        refreshedAt: this.clock(),
+        serverOffset: now - this.clock(),
+      };
