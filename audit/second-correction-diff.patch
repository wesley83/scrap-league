+        }
+        try {
+          await this.store.settleRun(
+            entry.run.id,
+            entry.lease.id,
+            state,
+            message,
+            this.clock(),
+            serverRetryAt,
+          );
+          outcomes.push({ id: entry.run.id, state });
+        } catch {
